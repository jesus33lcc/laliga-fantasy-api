# Convenciones de formato del repositorio.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 95

[*.{js,mjs,css,html,json,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
# En Markdown dos espacios al final son un salto de línea: recortarlos lo rompe.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
