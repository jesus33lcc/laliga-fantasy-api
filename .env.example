# Copia este fichero a .env y rellena los huecos. El .env NUNCA va al repo.
#   cp .env.example .env && chmod 600 .env

# --- Credenciales de LaLiga Fantasy ---------------------------------------
# AQUÍ NO VA NINGUNA CONTRASEÑA.
# El login de LaLiga es Authorization Code + PKCE: interactivo y UNA sola vez en
# el navegador, con Google o con tu correo y contraseña de LaLiga.
#
#     docker compose run --rm worker python scripts/login.py
#
# Eso guarda el refresh token en /data/token.json (chmod 600) y a partir de ahí
# el sistema se renueva solo. La contraseña no llega nunca a este proyecto, así
# que no se guarda en ningún sitio.

# Se autodescubren al loguear. Rellénalos si sales en varias ligas.
FANTASY_LEAGUE_ID=
FANTASY_TEAM_ID=

# --- Infra ----------------------------------------------------------------
DB_PASSWORD=                   # inventa una larga; no la de por defecto

# --- Politeness -----------------------------------------------------------
# 0.5 req/s es la mitad de lo que se autoimpone el cliente oficial de LaLiga.
# Subirlo es la forma más rápida de ganarse un 429 y, con suerte, solo eso.
RATE_LIMIT_RPS=0.5
RATE_LIMIT_BURST=5
USER_AGENT=fantasy-coconut/0.1 (uso privado)

# --- Alertas (Telegram) ---------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
